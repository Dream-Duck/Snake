
/**
 * SettingsPopup.
 * Displays the settings, rules and instructions for the game.
 *
 * @author Zahra Salemi
 * @version 2026
 */
import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Font;
import java.awt.Insets;
import javax.swing.JButton;
import javax.swing.JDialog;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JTextArea;
public class SettingsPopup extends JDialog
{
    // The dark green colour used throughout the game
    private final Color DARK_GREEN = new Color(20, 90, 45);

    // The light colour used for text
    private final Color LIGHT_TEXT = new Color(235, 255, 235);

    // The lighter green used for the information area
    private final Color LIGHT_GREEN = new Color(210, 240, 210);

    /**
     * Creates the settings window.
     */
    public SettingsPopup()
    {
        // Sets the title of the settings window
        setTitle("Settings");

        // Sets the size of the settings window
        setSize(400, 450);

        // Places the settings window in the centre
        setLocationRelativeTo(null);

        // Prevents the settings window from being resized
        setResizable(false);

        // Closes the settings window when the X is pressed
        setDefaultCloseOperation(DISPOSE_ON_CLOSE);

        // Creates the title at the top of the settings window
        JLabel title = new JLabel("Settings", JLabel.CENTER);

        // Makes the title bigger and easier to see
        title.setFont(new Font("Arial", Font.BOLD, 22));

        // Changes the title colour
        title.setForeground(LIGHT_TEXT);

        // Creates the main panel for the settings
        JPanel mainPanel = new JPanel(new BorderLayout());

        // Changes the background to dark green
        mainPanel.setBackground(DARK_GREEN);

        // Creates the area containing the rules and instructions
        JTextArea information = new JTextArea();

        // Prevents the player from changing the text
        information.setEditable(false);

        // Adds the rules and instructions
        information.setText(
            "Rules\n\n" +
            "• Eat the fruit to increase your score.\n" +
            "• The snake grows when it eats fruit.\n" +
            "• Do not hit the walls.\n" +
            "• Do not hit your own body.\n\n" +

            "Instructions\n\n" +
            "• Use the arrow keys to move.\n" +
            "• Move the snake towards the fruit.\n\n" +

            "Two Player Mode\n\n"
        );

        // Changes the information area's colours
        information.setBackground(LIGHT_GREEN);
        information.setForeground(DARK_GREEN);

        // Makes the information easier to read
        information.setFont(new Font("Arial", Font.PLAIN, 15));

        // Adds some space around the text
        information.setMargin(new Insets(15, 15, 15, 15));

        // Creates a button for closing the settings
        JButton closeButton = new JButton("Close");

        // Changes the close button colours
        closeButton.setBackground(DARK_GREEN);
        closeButton.setForeground(LIGHT_TEXT);

        // Removes the focus border from the button
        closeButton.setFocusPainted(false);

        // Close the settings when the button is pressed
        closeButton.addActionListener(e -> dispose());

        // Creates a panel for the close button
        JPanel bottomPanel = new JPanel();

        // Changes the bottom panel to dark green
        bottomPanel.setBackground(DARK_GREEN);

        // Adds the close button to the bottom panel
        bottomPanel.add(closeButton);

        // Adds the title to the top of the settings window
        mainPanel.add(title, BorderLayout.NORTH);

        // Adds the information to the middle of the settings window
        mainPanel.add(information, BorderLayout.CENTER);

        // Adds the close button to the bottom
        mainPanel.add(bottomPanel, BorderLayout.SOUTH);

        // Adds the themed panel to the settings window
        add(mainPanel);
    }
}
