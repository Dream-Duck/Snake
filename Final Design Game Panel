/**
 * GamePanel.
 * Displays the main game board and game information.
 *
 * @author Zahra Salemi
 * @version 2026
 */
import java.awt.Color;
import java.awt.Dimension;
import java.awt.Font;
import java.awt.Graphics;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;
import javax.swing.JButton;
import javax.swing.JPanel;
import javax.swing.Timer;

public class GamePanel extends JPanel implements KeyListener
{
    // The width of the game window
    private final int WINDOW_WIDTH = 600;

    // The height of the game window
    private final int WINDOW_HEIGHT = 700;

    // The size of each square in the playing grid
    private final int TILE_SIZE = 25;

    // The number of squares across the board
    private final int GRID_WIDTH = 20;

    // The number of squares down the board
    private final int GRID_HEIGHT = 20;

    // The starting position of the game board
    private final int BOARD_X = 50;
    private final int BOARD_Y = 70;

    // The colour used for the dark green borders
    private final Color DARK_GREEN = new Color(20, 90, 45);

    // The colour used for the lighter checker squares
    private final Color LIGHT_GREEN = new Color(210, 240, 210);

    // The colour used for the second checker squares
    private final Color LIGHTER_GREEN = new Color(190, 230, 190);

    // The colour used for the grid lines
    private final Color GRID_GREEN = new Color(100, 150, 100);

    // The colour used for the text on the dark green areas
    private final Color LIGHT_TEXT = new Color(235, 255, 235);

    // The colour used for the snake
    private final Color SNAKE_GREEN = new Color(20, 150, 55);

    // The colour used for the fruit
    private final Color FRUIT_RED = new Color(220, 40, 40);

    // The button used to open the settings
    private JButton settingsButton;

    // The number of segments currently in the snake
    private int snakeLength;

    // Stores the horizontal grid position of each snake segment
    private int[] snakeGridX;

    // Stores the vertical grid position of each snake segment
    private int[] snakeGridY;

    // Stores the horizontal drawing position of each snake segment
    private double[] snakeX;

    // Stores the vertical drawing position of each snake segment
    private double[] snakeY;

    // The direction the snake is currently moving
    private int directionX;
    private int directionY;

    // The direction the player wants the snake to move
    private int nextDirectionX;
    private int nextDirectionY;

    // Keeps track of whether the game has started
    private boolean gameStarted;

    // Keeps track of whether the snake is currently moving between squares
    private boolean moving;

    // The timer used to animate the snake
    private Timer movementTimer;

    // The speed of the snake animation
    private final double SNAKE_SPEED = 2.5;

    /**
     * Creates the game panel and sets up the buttons.
     */
    public GamePanel()
    {
        // Sets the size of the game window
        setPreferredSize(new Dimension(WINDOW_WIDTH, WINDOW_HEIGHT));

        // Sets the background colour to dark green
        setBackground(DARK_GREEN);

        // Allows the panel to receive keyboard input
        setFocusable(true);

        // Allows the panel to listen for keyboard presses
        addKeyListener(this);

        // Uses manual positioning for the settings button
        setLayout(null);

        // Creates the settings button
        settingsButton = new JButton("?");

        // Sets the position and size of the settings button
        settingsButton.setBounds(525, 15, 45, 40);

        // Changes the settings button to match the colour theme
        settingsButton.setBackground(DARK_GREEN);
        settingsButton.setForeground(LIGHT_TEXT);

        // Removes the focus border from the button
        settingsButton.setFocusPainted(false);

        // Adds the settings button to the panel
        add(settingsButton);

        // Opens the settings window when the button is clicked
        settingsButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e)
            {
                // Opens the settings window
                SettingsPopup settings = new SettingsPopup();

                // Displays the settings window
                settings.setVisible(true);

                // Gives the game panel keyboard focus again
                requestFocusInWindow();
            }
        });

        // Creates space for up to 100 snake segments
        snakeGridX = new int[100];
        snakeGridY = new int[100];
        snakeX = new double[100];
        snakeY = new double[100];

        // Starts the snake with four segments
        snakeLength = 4;

        // Places the snake safely inside the grid
        snakeGridX[0] = 4;
        snakeGridY[0] = 2;

        snakeGridX[1] = 3;
        snakeGridY[1] = 2;

        snakeGridX[2] = 2;
        snakeGridY[2] = 2;

        snakeGridX[3] = 1;
        snakeGridY[3] = 2;

        // Converts the grid positions into drawing positions
        for (int i = 0; i < snakeLength; i++) {
            snakeX[i] = BOARD_X + snakeGridX[i] * TILE_SIZE;
            snakeY[i] = BOARD_Y + snakeGridY[i] * TILE_SIZE;
        }

        // Makes the snake start with no movement
        directionX = 0;
        directionY = 0;

        // Stores the direction the player chooses
        nextDirectionX = 0;
        nextDirectionY = 0;

        // Keeps the game stopped until the player presses a key
        gameStarted = false;

        // The snake is not moving between squares yet
        moving = false;

        // Creates the timer that controls the snake animation
        movementTimer = new Timer(16, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e)
            {
                // Moves the snake
                moveSnake();

                // Redraws the game
                repaint();
            }
        });

        // Starts the timer
        movementTimer.start();
    }

    /**
     * Moves the snake smoothly between grid squares.
     *
     */
    private void moveSnake()
    {
        // Does not move the snake until the game has started
        if (!gameStarted) {
            return;
        }

        // Starts a new movement when the snake reaches a grid square
        if (!moving) {

            // Applies the direction chosen by the player
            directionX = nextDirectionX;
            directionY = nextDirectionY;

            // Checks that the snake has a direction
            if (directionX != 0 || directionY != 0) {

                // Calculates where the head wants to move
                int newGridX = snakeGridX[0] + directionX;
                int newGridY = snakeGridY[0] + directionY;

                // Checks that the new position is inside the board
                if (newGridX >= 0 &&
                    newGridX < GRID_WIDTH &&
                    newGridY >= 0 &&
                    newGridY < GRID_HEIGHT) {

                    // Moves each body segment to the previous
                    // segment's grid position
                    for (int i = snakeLength - 1; i > 0; i--) {
                        snakeGridX[i] = snakeGridX[i - 1];
                        snakeGridY[i] = snakeGridY[i - 1];
                    }

                    // Moves the head to its new grid position
                    snakeGridX[0] = newGridX;
                    snakeGridY[0] = newGridY;

                    // Starts the smooth animation
                    moving = true;
                }
            }
        }

        // Smoothly moves every segment towards its grid position
        if (moving) {

            // Tracks whether every segment has reached its target
            boolean allSegmentsReady = true;

            // Moves every segment
            for (int i = 0; i < snakeLength; i++) {

                // Finds the target horizontal position
                double targetX =
                    BOARD_X + snakeGridX[i] * TILE_SIZE;

                // Finds the target vertical position
                double targetY =
                    BOARD_Y + snakeGridY[i] * TILE_SIZE;

                // Moves the segment horizontally towards its target
                if (Math.abs(snakeX[i] - targetX) > SNAKE_SPEED) {

                    if (snakeX[i] < targetX) {
                        snakeX[i] += SNAKE_SPEED;
                    }
                    else {
                        snakeX[i] -= SNAKE_SPEED;
                    }

                    allSegmentsReady = false;
                }
                else {
                    snakeX[i] = targetX;
                }

                // Moves the segment vertically towards its target
                if (Math.abs(snakeY[i] - targetY) > SNAKE_SPEED) {

                    if (snakeY[i] < targetY) {
                        snakeY[i] += SNAKE_SPEED;
                    }
                    else {
                        snakeY[i] -= SNAKE_SPEED;
                    }

                    allSegmentsReady = false;
                }
                else {
                    snakeY[i] = targetY;
                }
            }

            // Allows the snake to start its next grid movement
            if (allSegmentsReady) {
                moving = false;
            }
        }
    }

    /**
     * Draws everything that appears on the game screen.
     *
     */
    @Override
    protected void paintComponent(Graphics g)
    {
        super.paintComponent(g);
        draw(g);
    }

    /**
     * Draws the game board, grid, snake, fruit, and score.
     *
     */
    private void draw(Graphics g)
    {
        // Draws the dark green top area
        g.setColor(DARK_GREEN);
        g.fillRect(0, 0, WINDOW_WIDTH, BOARD_Y);

        // Draws the dark green bottom area
        g.fillRect(
            0,
            BOARD_Y + GRID_HEIGHT * TILE_SIZE,
            WINDOW_WIDTH,
            WINDOW_HEIGHT - (BOARD_Y + GRID_HEIGHT * TILE_SIZE)
        );

        // Draws the checkerboard grid
        drawGrid(g);

        // Draws the snake
        drawSnake(g);

        // Draws the placeholder fruit
        drawFruit(g);

        // Draws the title using a light colour
        g.setColor(LIGHT_TEXT);
        g.setFont(new Font("Arial", Font.BOLD, 24));
        g.drawString("Snake Game", 235, 40);

        // Draws the score using a light colour
        g.setFont(new Font("Arial", Font.BOLD, 18));
        g.drawString("Score: 0", 260, 625);

        // Draws the high score using a light colour
        g.drawString("High Score: 0", 235, 655);
    }

    /**
     * Draws the checkerboard playing grid.
     *
     */
    private void drawGrid(Graphics g)
    {
        // Goes through every row of the playing area
        for (int row = 0; row < GRID_HEIGHT; row++) {
            // Goes through every column of the playing area
            for (int column = 0; column < GRID_WIDTH; column++) {

                // Changes the colour of every second square
                if ((row + column) % 2 == 0) {
                    g.setColor(LIGHT_GREEN);
                }
                else {
                    g.setColor(LIGHTER_GREEN);
                }

                // Draws the current square
                g.fillRect(
                    BOARD_X + column * TILE_SIZE,
                    BOARD_Y + row * TILE_SIZE,
                    TILE_SIZE,
                    TILE_SIZE
                );

                // Draws the green grid lines
                g.setColor(GRID_GREEN);
                g.drawRect(
                    BOARD_X + column * TILE_SIZE,
                    BOARD_Y + row * TILE_SIZE,
                    TILE_SIZE,
                    TILE_SIZE
                );
            }
        }

        // Draws the dark green border around the playing grid
        g.setColor(DARK_GREEN);

        // Draws the top border
        g.fillRect(
            BOARD_X - 5,
            BOARD_Y - 5,
            GRID_WIDTH * TILE_SIZE + 10,
            5
        );

        // Draws the bottom border
        g.fillRect(
            BOARD_X - 5,
            BOARD_Y + GRID_HEIGHT * TILE_SIZE,
            GRID_WIDTH * TILE_SIZE + 10,
            5
        );

        // Draws the left border
        g.fillRect(
            BOARD_X - 5,
            BOARD_Y,
            5,
            GRID_HEIGHT * TILE_SIZE
        );

        // Draws the right border
        g.fillRect(
            BOARD_X + GRID_WIDTH * TILE_SIZE,
            BOARD_Y,
            5,
            GRID_HEIGHT * TILE_SIZE
        );
    }

    /**
     * Draws the snake and its body.
     *
     */
    private void drawSnake(Graphics g)
    {
        // Sets the snake colour
        g.setColor(SNAKE_GREEN);

        // Draws each segment of the snake
        for (int i = 0; i < snakeLength; i++) {

            // Draws the current snake segment
            g.fillRect(
                (int) snakeX[i],
                (int) snakeY[i],
                TILE_SIZE,
                TILE_SIZE
            );
        }
    }

    /**
     * Draws the placeholder fruit.
     *
     */
    private void drawFruit(Graphics g)
    {
        // Sets the fruit colour
        g.setColor(FRUIT_RED);

        // Draws the fruit inside one of the grid squares
        g.fillRect(300, 295, TILE_SIZE, TILE_SIZE);
    }

    /**
     * Detects when a key is pressed.
     *
     */
    @Override
    public void keyPressed(KeyEvent e)
    {
        // Checks which key was pressed
        switch (e.getKeyCode()) {

            // Changes the snake direction to up
            case KeyEvent.VK_UP:

                // Prevents the snake from immediately reversing
                if (directionY != 1) {
                    nextDirectionX = 0;
                    nextDirectionY = -1;
                    gameStarted = true;
                }
                break;

            // Changes the snake direction to down
            case KeyEvent.VK_DOWN:

                // Prevents the snake from immediately reversing
                if (directionY != -1) {
                    nextDirectionX = 0;
                    nextDirectionY = 1;
                    gameStarted = true;
                }
                break;

            // Changes the snake direction to the left
            case KeyEvent.VK_LEFT:

                // Prevents the snake from immediately reversing
                if (directionX != 1) {
                    nextDirectionX = -1;
                    nextDirectionY = 0;
                    gameStarted = true;
                }
                break;

            // Changes the snake direction to the right
            case KeyEvent.VK_RIGHT:

                // Prevents the snake from immediately reversing
                if (directionX != -1) {
                    nextDirectionX = 1;
                    nextDirectionY = 0;
                    gameStarted = true;
                }
                break;

            // Does nothing for other keys
            default:
                break;
        }
    }

    /**
     * Required method for KeyListener.
     *
     */
    @Override
    public void keyTyped(KeyEvent e)
    {
        // Nothing is needed here
    }

    /**
     * Required method for KeyListener.
     *
     */
    @Override
    public void keyReleased(KeyEvent e)
    {
        // Nothing is needed here
    }
}
